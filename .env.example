# cp .env.example .env  후 값 입력
ANTHROPIC_API_KEY=

# 선택
# 기본 구성 (아무것도 안 쓰면): 설계·코드·디버깅 노드 = claude-sonnet-5-5,
#                              router / paper_scout / query_rewriter = claude-haiku-4-5
# MY_FRIEND_MODEL=claude-haiku-4-5          # 설정하면 모든 노드를 이 모델로 일괄 지정 (예: 최저가 배선 테스트)

# 노드별 모델 (가장 우선). 허용 모델 = structured outputs 지원 모델:
#   claude-fable-5-1, claude-fable-5, claude-opus-5-5, claude-opus-5, claude-opus-4-8,
#   claude-sonnet-5-5, claude-sonnet-5, claude-haiku-4-5
# 모델 능력에 맞춰 자동 조정: haiku-4-5는 effort/thinking 미전송, max_tokens 64k로 제한.
# 거절 시 서버측 fallback(fallbacks="default")은 fable-5-1 / opus-5-5 / opus-5 / sonnet-5-5에서만 켜진다.
# MY_FRIEND_MODEL_ROUTER=
# MY_FRIEND_MODEL_PAPER_SCOUT=
# MY_FRIEND_MODEL_SPARRING_PARTNER=
# MY_FRIEND_MODEL_PLANNER=
# MY_FRIEND_MODEL_EXECUTOR=
# MY_FRIEND_MODEL_PARTIAL_EXECUTOR=
# MY_FRIEND_MODEL_REFLECTOR=
# MY_FRIEND_MODEL_QUERY_REWRITER=            # RAG 인덱스가 있을 때만 사용
# DISABLE_ARXIV=1              # 오프라인 서버: arXiv 검색 비활성화
# MY_FRIEND_PORT=8000
# CHECKPOINT_DB=data/checkpoints.sqlite   # 세션 체크포인트 (재시작해도 유지)
